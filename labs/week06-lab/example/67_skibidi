def convert_currency(value,currency):
    if currency == USD:
        money=value * 33
    elif currency == THB:
        money=value / 33
    return money 


value=float(input("Enter Value"))
currency=input("Enter your currency")
convert_currency(value,currency)
print(f"{money} {currency}")